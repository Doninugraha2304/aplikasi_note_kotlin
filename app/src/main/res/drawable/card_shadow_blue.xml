<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#40667EEA" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    
    <!-- Main Card -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#667EEA"
                android:endColor="#764BA2"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
