<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/noteCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header with Category & Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/categoryChip"
                style="@style/Widget.Material3.Chip.Assist.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"
                tools:text="💼 Work"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/favoriteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_favorite"
                android:visibility="gone"
                android:contentDescription="Favorite"
                app:tint="#FFD700" />

            <ImageView
                android:id="@+id/pinIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pin"
                android:visibility="gone"
                android:contentDescription="Pinned"
                app:tint="#FF6B6B" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:layout_marginBottom="10dp"
            tools:text="My Important Note Title" />

        <!-- Content -->
        <TextView
            android:id="@+id/textContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="5"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="14dp"
            tools:text="This is the note content that will be displayed in the card view with more details." />

        <!-- Footer with Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:borderlessButtonStyle="?attr/colorOutlineVariant">

            <TextView
                android:id="@+id/textDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:drawablePadding="4dp"
                tools:text="📅 25 Feb 2026, 10:30" />

            <TextView
                android:id="@+id/textWordCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:layout_marginStart="12dp"
                tools:text="📝 125 words" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
